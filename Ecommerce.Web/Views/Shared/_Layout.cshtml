<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ecommerce.Web</title>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce.Web.styles.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: #2c3e50; /* Dark Slate */
            --accent-color: #3498db; /* Bright Blue */
            --deal-color: #e74c3c; /* Red for deals */
            --bg-light: #f8f9fa;
        }

        body {
            background-color: var(--bg-light);
            font-family: 'Segoe UI', Roboto, "Helvetica Neue", Arial, sans-serif;
        }

        /* --- NAVBAR STYLES --- */
        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: var(--primary-color) !important;
            letter-spacing: -1px;
        }

        .search-container {
            position: relative;
            width: 100%;
            max-width: 600px;
        }

        .search-input {
            border-radius: 50px;
            padding-left: 20px;
            padding-right: 50px;
            border: 2px solid #eee;
            background: #f1f3f5;
            transition: all 0.3s;
        }

            .search-input:focus {
                background: #fff;
                border-color: var(--accent-color);
                box-shadow: 0 0 0 4px rgba(52, 152, 219, 0.1);
            }

        .search-btn {
            position: absolute;
            right: 5px;
            top: 5px;
            bottom: 5px;
            border-radius: 50%;
            width: 33px;
            background: var(--primary-color);
            color: white;
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* --- SMOOTH DROPDOWN ANIMATION (From previous request) --- */
        .dropdown-menu {
            display: block;
            opacity: 0;
            visibility: hidden;
            margin-top: 20px !important;
            transition: all 0.3s cubic-bezier(0.68, -0.55, 0.27, 1.55);
            right: 0;
            left: auto;
            border-radius: 12px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        }

            .dropdown-menu.show {
                opacity: 1;
                visibility: visible;
                margin-top: 10px !important;
            }

        .nav-icon {
            font-size: 1.3rem;
            color: var(--primary-color);
            transition: transform 0.2s;
        }

            .nav-icon:hover {
                transform: scale(1.1);
            }

        /* --- HERO SECTION (Bento Grid) --- */
        .hero-card {
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            background-size: cover;
            background-position: center;
            transition: transform 0.3s;
        }

            .hero-card:hover {
                transform: translateY(-5px);
            }

        .hero-main {
            height: 400px;
            background-color: #dbeafe; /* Fallback */
            background-image: linear-gradient(135deg, #dbeafe 0%, #eff6ff 100%);
            display: flex;
            align-items: center;
            padding: 40px;
        }

        .hero-side {
            height: 190px;
            background-color: #fae8ff;
            margin-bottom: 20px;
            padding: 20px;
        }

            .hero-side.bottom {
                margin-bottom: 0;
                background-color: #fee2e2;
            }

        /* --- CATEGORIES --- */
        .cat-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s;
            border: 1px solid transparent;
            cursor: pointer;
        }

            .cat-card:hover {
                border-color: var(--accent-color);
                box-shadow: 0 10px 20px rgba(0,0,0,0.05);
                transform: translateY(-5px);
            }

        .cat-icon {
            font-size: 2rem;
            color: var(--primary-color);
            margin-bottom: 10px;
        }

        /* --- PRODUCT CARDS --- */
        .product-card {
            border: none;
            border-radius: 16px;
            background: white;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .product-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            }

        .badge-deal {
            position: absolute;
            top: 15px;
            left: 15px;
            background: var(--deal-color);
            color: white;
            padding: 5px 10px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.8rem;
        }

        .product-img-wrapper {
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fff;
            padding: 20px;
        }

        .product-img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .price-new {
            font-weight: 800;
            color: var(--primary-color);
            font-size: 1.1rem;
        }

        .price-old {
            text-decoration: line-through;
            color: #999;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-white sticky-top py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Lumina
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navContent">

                    <div class="mx-auto my-3 my-lg-0 search-container">
                        <input type="text" class="form-control search-input" placeholder="Search for products, brands and more...">
                        <button class="search-btn"><i class="bi bi-search"></i></button>
                    </div>

                    <div class="d-flex align-items-center gap-4 justify-content-end">

                        <a href="#" class="position-relative nav-icon">
                            <i class="bi bi-cart3"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">2</span>
                        </a>


                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" class="d-flex align-items-center text-decoration-none">
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="
    background-color: darkslategrey;
    color: white;
    width: 31px;
    height: 31px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;    
    font-size: 14px;
    text-transform: uppercase;
    user-select: none;">

                                            @User.Identity.Name?.FirstOrDefault()
                                        </div>
                                        <span class="d-none d-lg-block fw-semibold text-dark">@User.Identity.Name</span>
                                        <i class="bi bi-chevron-down small text-muted"></i>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item rounded-2 py-2" href="#"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" href="#"><i class="bi bi-box-seam me-2"></i>Orders</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" href="#"><i class="bi bi-heart me-2"></i>Wishlist</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item rounded-2 py-2 text-danger" href="/account/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                                </ul>

                            </div>
                        }
                        else
                        {
                            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                        }

                    </div>
                </div>
            </div>
        </nav>

    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-white mb-3"><i class="bi bi-lightning-charge-fill text-warning"></i> Lumina</h5>
                    <p class="text-white-50">The ultimate destination for premium tech and lifestyle products. Quality guaranteed.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Shop</h6>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">New Arrivals</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Best Sellers</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Electronics</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Support</h6>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Help Center</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Returns</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold mb-3">Newsletter</h6>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Enter your email">
                        <button class="btn btn-primary">Subscribe</button>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center text-white-50 small">
                &copy; 2023 Lumina Inc. All rights reserved.
            </div>
        </div>
    </footer>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
