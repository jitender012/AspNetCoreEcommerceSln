<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ecommerce.Web</title>
    <script src="~/lib/jquery/jquery.min.js"></script>
    
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/pages/customer/layout.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-white sticky-top py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                    <i class="bi bi-lightning-charge-fill text-warning"></i> Lumina
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navContent">

                    <div class="mx-auto my-3 my-lg-0 search-container">
                        <input type="text" class="form-control search-input" placeholder="Search for products, brands and more...">
                      <a href="@Url.Action("Search", "Product", new { area = "Customer" })" class="search-btn">
                        <i class="bi bi-search"></i>
                    </a>


                    </div>                   
                    <div class="d-flex align-items-center gap-4 justify-content-end">

                        <a href="@Url.Action("Index","Cart", new {area ="customer"})" class="position-relative nav-icon">
                            <i class="bi bi-cart3"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem;">2</span>
                        </a>


                        @if (User?.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <a href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false" class="d-flex align-items-center text-decoration-none">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="user-pp">

                                            @User.Identity.Name?.FirstOrDefault()
                                        </div>
                                        <span class="d-none d-lg-block fw-semibold text-dark">@User.Identity.Name</span>
                                        <i class="bi bi-chevron-down small text-muted"></i>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item rounded-2 py-2" href="@Url.Action("Index","Account", new {area ="customer"})"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" href="@Url.Action("Index","Order", new {area ="customer"})"><i class="bi bi-box-seam me-2"></i>Orders</a></li>
                                    <li><a class="dropdown-item rounded-2 py-2" href="#"><i class="bi bi-heart me-2"></i>Wishlist</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item rounded-2 py-2 text-danger" href="/account/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                                </ul>

                            </div>
                        }
                        else
                        {
                            <a class="nav-link text-dark" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                        }

                    </div>
                </div>
            </div>
        </nav>

    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-white mb-3"><i class="bi bi-lightning-charge-fill text-warning"></i> Lumina</h5>
                    <p class="text-white-50">The ultimate destination for premium tech and lifestyle products. Quality guaranteed.</p>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Shop</h6>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">New Arrivals</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Best Sellers</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Electronics</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold mb-3">Support</h6>
                    <ul class="list-unstyled text-white-50">
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Help Center</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Returns</a></li>
                        <li class="mb-2"><a href="#" class="text-reset text-decoration-none">Privacy Policy</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold mb-3">Newsletter</h6>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Enter your email">
                        <button class="btn btn-primary">Subscribe</button>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <div class="text-center text-white-50 small">
                &copy; 2023 Lumina Inc. All rights reserved.
            </div>
        </div>
    </footer>
   

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
