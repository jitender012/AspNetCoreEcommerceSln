@using eCommerce.Application.Features.WarehouseFeature.Dtos
@{
    ViewData["Title"] = "Stores";
    Layout = "~/Areas/Seller/Views/Shared/_VendorLayout.cshtml";
}
@model List<WarehouseDto>




<div class="custom-section mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div aria-label="breadcrumb">
            <ol class="breadcrumb-custom">
                <li>
                    <a href="/seller">
                        <i class="fas fa-home"></i>
                    </a>
                </li>
                <li>
                    <span class="breadcrumb-separator">/</span>
                    <span class="active">Stores</span>
                </li>

            </ol>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <button class="btn" onclick="history.back()">⬅ Back</button>
        </div>
    </div>
</div>



<!-- Filters -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 justify-content-between">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="searchInput" placeholder="Search stores...">
                </div>
            </div>
            <div class="col-md-2">
                <div class="btn-group w-100">
                    <button type="button" class="btn btn-primary" id="listViewBtn" title="List View">
                        <i class="fas fa-list"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="gridViewBtn" title="Grid View">
                        <i class="fas fa-th"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">Stores</h5>
        <small class="text-muted">
            Showing <span id="showingCount">@Model.Count</span> of <span id="totalCount">@Model.Count</span> stores
        </small>
    </div>
    <div class="card-body p-0">
        <!-- List View (Default) -->
        <div id="listView">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="40">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="selectAll">
                                </div>
                            </th>

                            <th>Store Name</th>
                            <th width="120">Email</th>
                            <th width="120">City</th>
                            <th width="150">State</th>
                            <th width="180">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="brandsTableBody">
                        @foreach (var warehouse in Model)
                        {
                            <tr>
                                @*                                 <td>
                                    <div class="form-check">
                                        <input class="form-check-input brand-checkbox" type="checkbox"
                                               value="@brand.BrandId">
                                    </div>
                                </td>                            
 *@                             
 
 <td></td>
                                <td>
                                    <h6 class="mb-1">@warehouse.Name</h6>
                                    <small class="text-muted">ID: @warehouse.WarehouseId.ToString().Substring(0, 8)...</small>
                                </td>

                                <td>
                                    <h6 class="mb-1">@(warehouse.Email ?? "-")</h6>
                                </td>

                                <td id="brand-status-@warehouse.City">
                                    <h6 class="mb-1">@(warehouse.City ?? "-")</h6>
                                </td>

                                <td>
                                    <h6 class="mb-1">@(warehouse.State ?? "-") </h6>
                                </td>

                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="/seller/warehouse/details" class="btn btn-outline-info" title="View"><i class="fas fa-eye"></i></a>
                                        <a href="brands/edit/@warehouse.WarehouseId" class="btn btn-outline-primary" title="Edit"><i class="fas fa-edit"></i></a>
                                        <button type="button" class="btn btn-outline-danger"
                                                onclick="deleteBrand('@warehouse.WarehouseId')"
                                                title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Grid View -->
        @*  <div id="gridView" style="display: none;">
            <div class="p-4">
                <div class="row g-4" id="brandsGridContainer">
                    @foreach (var brand in Model)
