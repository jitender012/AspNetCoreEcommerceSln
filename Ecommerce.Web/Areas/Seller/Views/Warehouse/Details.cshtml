@{
    Layout = "~/Areas/Seller/Views/Shared/_VendorLayout.cshtml";
}
<!-- Breadcrumb -->
<div class="custom-section mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb-custom">
            <li>
                <a href="#">
                    <i class="fas fa-home"></i>
                </a>
            </li>
            <li>
                <span class="breadcrumb-separator">/</span>
                <a href="#">Warehouses</a>
            </li>
            <li>
                <span class="breadcrumb-separator">/</span>
                <span class="active">Main Warehouse - New York</span>
            </li>
        </ol>
    </nav>
</div>

<div class="custom-section py-4 mb-3">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="page-title" id="warehouseName">Main Warehouse - New York</h1>
            <p class="page-subtitle">
                <i class="fas fa-map-marker-alt"></i>
                <span id="warehouseAddress">123 Storage Blvd, New York, NY 10001</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success-custom btn-custom">
                <i class="fas fa-plus"></i> Add Variant
            </button>
            <div class="dropdown">
                <button class="btn btn-outline-custom btn-custom dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <i class="fas fa-ellipsis-v"></i>
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#"><i class="fas fa-edit"></i> Edit Warehouse</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-download"></i> Export Inventory</a></li>
                    <li><a class="dropdown-item" href="#"><i class="fas fa-history"></i> View All History</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="fas fa-trash"></i> Delete Warehouse</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>


<!-- Quick Stats Row -->
<div class="row mb-4">
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat-card blue position-relative">
            <i class="fas fa-dollar-sign stat-icon text-primary"></i>
            <div class="stat-value">23</div>
            <div class="stat-label">Total Variants</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat-card green position-relative">
            <i class="fas fa-warehouse stat-icon"></i>
            <div class="stat-value" id="statRevenue">-</div>
            <div class="stat-label">Total Stock</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat-card teal position-relative">
            <i class="fas fa-warehouse stat-icon"></i>
            <div class="stat-value" id="statRevenue">-</div>
            <div class="stat-label">Low Stock Items</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6 mb-3">
        <div class="stat-card orange position-relative">
            <i class="fas fa-exclamation-triangle fa-2x stat-icon" style="color: var(--warning-orange);"></i>
            <div class="stat-value" id="statRevenue">-</div>
            <div class="stat-label">Reserved Stock</div>
        </div>
    </div>
</div>
