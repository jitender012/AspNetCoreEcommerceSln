@{
    Layout = "~/Areas/Seller/Views/Shared/_VendorLayout.cshtml";
}

<button class="btn btn mb-3" data-bs-toggle="modal" data-bs-target="#MyModal">
    <i class="fas fa-plus me-2"></i>Open Modal
</button>
<!-- Add item Modal -->
<div class="modal fade" id="MyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add Existing Items</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <select class="js-select2 form-control" id="mySelect">
                    <option value="">Select product</option>
                    <option value="1">iPhone</option>
                    <option value="2">Samsung</option>
                    <option value="3">OnePlus</option>
                </select>
            </div>
        </div>
    </div>
</div>

<select class="js-example-basic-single form-control" name="state">
    <option value="AL">Alabama</option>
    <option value="AL">UP</option>
    <option value="AL">MP</option>
    <option value="AL">Gujrat</option>
    <option value="AL">Rajasthan</option>
    <option value="AL">Bengal</option>
    <option value="WY">Wyoming</option>
</select>

<script>
    //     $(document).ready(function() {
    //     $('.js-example-basic-single').select2();
    // });

    $('#MyModal').on('shown.bs.modal', function () {
      $('#mySelect').select2({
        dropdownParent: $('#MyModal'),
        width: '100%'
      });
    });

</script>