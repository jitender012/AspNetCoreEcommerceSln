@{
    ViewData["Title"] = "Add New Product";
    Layout = "~/Areas/Seller/Views/Shared/_VendorLayout.cshtml";
}

@model ProductSaveVM


<link href="~/css/product-create.css" rel="stylesheet" />
<div class="container-fluid py-4">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 mb-0">Add New Product</h1>
                    <p class="text-muted mb-0">Create a new product and generate variants automatically</p>
                </div>
                <div class="btn-group">
                    <a href="/seller/products" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Products
                    </a>
                   @*  <button type="button" class="btn btn-outline-info" id="saveAsDraftBtn">
                        <i class="fas fa-solid file-pen me-2"></i>Save as Draft
                    </button> *@
                </div>
            </div>
        </div>
    </div>


    <div class="dashboard-container">
        <!-- Progress Steps -->
        <div class="progress-steps">
            <div class="progress-line" id="progressLine"></div>
            <div class="step active" data-step="1">
                <div class="step-circle">1</div>
                <div class="step-label">Basic Info</div>
            </div>
            <div class="step" data-step="2">
                <div class="step-circle">2</div>
                <div class="step-label">Advance Info</div>
            </div>
            <div class="step" data-step="3">
                <div class="step-circle">3</div>
                <div class="step-label">Images</div>
            </div>
            <div class="step" data-step="4">
                <div class="step-circle">4</div>
                <div class="step-label">Review & Submit</div>
            </div>
        </div>

    </div>

    <div class="form-card ">

        <form id="productForm" asp-action="Create" asp-controller="Product" asp-area="Seller" method="post" enctype="multipart/form-data">

            <!-- Step 1: Basic Info -->
            <div class="form-step active" data-step="1">
                <h2 class="step-title">Basic Information</h2>
                <p class="step-description">Start by adding the basic details of your product</p>
                <div class="row">
                    <div class="col-md-12 mb-3">

                        <label asp-for="ProductName" class="form-label fw-semibold">
                            Product Name <span class="text-danger">*</span>
                        </label>
                        <input id="productName" asp-for="ProductName" class="form-control" placeholder="eg. iPhone 16" required />
                        <span asp-validation-for="ProductName" class="text-danger"></span>

                    </div>
                    <div class="col-md-12 mb-3">

                        <label asp-for="ProductVariant.VarientName" class="form-label fw-semibold">
                            Variant Name <span class="text-danger">*</span>
                        </label>
                        <input id="productName" asp-for="ProductVariant.VarientName" class="form-control" placeholder="eg. White, 128GB" required />
                        <span asp-validation-for="ProductVariant.VarientName" class="text-danger"></span>

                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="BrandId" class="form-label fw-semibold">
                            Brand <span class="text-danger">*</span>
                        </label>
                        @Html.DropDownListFor(x => x.BrandId, Model.BrandList, "-- Select Brand --", new { @class = "form-select", id = "brandName", @required = "true" })
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold">
                            Category <span class="text-danger">*</span>
                        </label>
                        @Html.DropDownListFor(x => x.CategoryId, Model.CategoryList, "-- Select Category --", new { @class = "form-select select2", id = "categorySelect", @required="true" })
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProductVariant.Price" class="form-label fw-semibold">
                            Base Price <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="ProductVariant.Price" type="number" step="0.01" class="form-control" placeholder="0.00" required/>
                        </div>
                        <span asp-validation-for="ProductVariant.Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProductVariant.SKU" class="form-label fw-semibold">SKU</label>
                        <input asp-for="ProductVariant.SKU" class="form-control" placeholder="e.g., SHIRT-RED-M" />
                        <span asp-validation-for="ProductVariant.SKU" class="text-danger"></span>
                        <small class="form-text text-muted">Leave empty to auto-generate</small>
                    </div>


                    <div class="col-md-12 mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Enter detailed product description..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>
                <div class="button-group">
                    <div></div>
                    <button type="button" class="btn btn-next btn-navigation" onclick="nextStep()">
                        Next <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- Step 2: Advance Info -->
            <div class="form-step" data-step="2">
                <h2 class="step-title">Additional Information</h2>
                <p class="step-description">Enter details and select appropriate values</p>



                <p class="text-muted" id="cardMessage">Select Category to see more details.</p>

                <div id="featuresList">
                    <!-- Attributes will be loaded here based on category -->
                </div>            


                <div class="button-group">
                    <button type="button" class="btn btn-back btn-navigation" onclick="prevStep()">
                        <i class="bi bi-arrow-left"></i> Back
                    </button>
                    <button type="button" class="btn btn-next btn-navigation" onclick="nextStep()">
                        Next <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>


            <!-- Step 3: Images -->
            <div class="form-step" data-step="3">
                <h2 class="step-title">Upload Images</h2>
                <p class="step-description">upload product images</p>

                <div class="mb-4">
                    <label class="form-label">Product Images *</label>
                    <div class="image-upload-area" onclick="document.getElementById('imageInput').click()">
                        <i class="bi bi-cloud-upload"></i>
                        <div class="fw-bold mb-1">Upload Images</div>
                        <small class="text-muted">Click to browse or drag and drop (Max 6 images)</small>
                    </div>
                    <input name="ProductVariant.ProductImages" type="file" id="imageInput" accept="image/*" multiple style="display: none;" onchange="handleImageUpload(event)">
                    <div class="image-preview-container" id="imagePreviewContainer"></div>
                </div>


                <div class="button-group">
                    <button type="button" class="btn btn-back btn-navigation" onclick="prevStep()">
                        <i class="bi bi-arrow-left"></i> Back
                    </button>
                    <button type="button" class="btn btn-next btn-navigation" onclick="nextStep()">
                        Next <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>


            <!-- Step 4: Review & Submit -->
            <div class="form-step" data-step="4">
                <h2 class="step-title">Review & Submit</h2>
                <p class="step-description">Review all details before submitting</p>

                <div class="review-section">
                    <h5><i class="bi bi-info-circle"></i> Basic Information</h5>
                    <div class="review-item">
                        <span class="review-label">Product Name:</span>
                        <span class="review-value" id="reviewProductName">-</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Brand:</span>
                        <span class="review-value" id="reviewBrand">-</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Category:</span>
                        <span class="review-value" id="reviewCategory">-</span>
                    </div>
                </div>

                <div class="review-section">
                    <h5><i class="bi bi-currency-rupee"></i> Pricing</h5>
                    <div class="review-item">
                        <span class="review-label">Regular Price:</span>
                        <span class="review-value" id="reviewPrice">-</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Discount:</span>
                        <span class="review-value" id="reviewDiscount">-</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Final Price:</span>
                        <span class="review-value fw-bold text-success" id="reviewFinalPrice">-</span>
                    </div>
                </div>

                <div class="review-section">
                    <h5><i class="bi bi-box-seam"></i> Inventory</h5>
                    <div class="review-item">
                        <span class="review-label">SKU:</span>
                        <span class="review-value" id="reviewSKU">-</span>
                    </div>
                    <div class="review-item">
                        <span class="review-label">Stock Quantity:</span>
                        <span class="review-value" id="reviewStock">-</span>
                    </div>
                </div>

                <div class="button-group">
                    <button type="button" class="btn btn-back btn-navigation" onclick="prevStep()">
                        <i class="bi bi-arrow-left"></i> Back
                    </button>
                    <button type="submit" class="btn btn-submit btn-navigation">
                        <i class="bi bi-check-circle"></i> Submit Product
                    </button>
                </div>
            </div>





            <div class="row">
                <!-- Main Product Information -->
                <div class="col-lg-8">
                    <!-- Step 1: Basic Information -->
                    @*  <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="card-title mb-0">
