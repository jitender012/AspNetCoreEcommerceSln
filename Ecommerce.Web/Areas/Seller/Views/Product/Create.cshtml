                    </div> *@

                    <!-- Step 2: Product Attributes -->
                   @*  <div class="card mb-4" id="attributesCard">
                        <div class="card-header ">
                            <h5 class="card-title mb-0">
                                <span class="badge bg-primary me-2">2</span>Additional Information
                            </h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted" id="cardMessage">Select Category to see more details.</p>

                            <div id="featuresList">
