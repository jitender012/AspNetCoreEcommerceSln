@using eCommerce.Application.Features.ProductVariantFeatures.Dtos
@model ProductVariantDetailsDto

@{
    Layout = "~/Areas/Seller/Views/Shared/_VendorLayout.cshtml";
    ViewData["Title"] = "Product Variant Details - " + Model.VariantName;
}
<style>
    .info-row{
        display: flex;
        margin-bottom:15px;
        justify-content: space-between;
    }
    .image-gallery {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 16px;
    }

    .image-item {
        position: relative;
        aspect-ratio: 1;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid var(--border-gray);
        transition: all 0.3s ease;
    }

        .image-item:hover {
            border-color: var(--primary-blue);
            transform: scale(1.02);
        }

        .image-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    @@media (max-width: 768px) {
        .info-row {
            flex-direction: column;
        }

        .info-label {
            width: 100%;
            margin-bottom: 4px;
        }
    }
</style>
<!-- Breadcrumb/Header -->
