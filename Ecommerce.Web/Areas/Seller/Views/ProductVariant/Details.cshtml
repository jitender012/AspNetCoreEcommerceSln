<script>


    function formatTimeAgo(date) {
        const seconds = Math.floor((new Date() - date) / 1000);

        const intervals = {
            year: 31536000,
            month: 2592000,
            week: 604800,
            day: 86400,
            hour: 3600,
            minute: 60
        };

        for (const [unit, secondsInUnit] of Object.entries(intervals)) {
            const interval = Math.floor(seconds / secondsInUnit);
            if (interval >= 1) {
                return interval === 1 ? `1 ${unit} ago` : `${interval} ${unit}s ago`;
            }
        }

        return 'Just now';
    }

    function triggerImageUpload() {
        $('#imageUpload').click();
    }

    function handleImageUpload(event) {
        const files = event.target.files;
        const gallery = $('#imageGallery');

        Array.from(files).forEach(file => {
            const reader = new FileReader();
            reader.onload = function(e) {
                const imageHtml = `
                    <div class="image-item">
                        <img src="${e.target.result}" alt="Variant image">
                        <button class="delete-image" onclick="deleteImage(this)">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;
                $('.image-upload').before(imageHtml);
            };
            reader.readAsDataURL(file);
        });

        // Reset input
        event.target.value = '';
    }

    function deleteImage(btn) {
        if (confirm('Are you sure you want to delete this image?')) {
            $(btn).closest('.image-item').fadeOut(300, function() {
                $(this).remove();
            });
        }
    }

    function saveChanges() {
        const updatedData = {
            stock: $('#inputStock').val(),
            price: $('#inputPrice').val(),
            status: $('#inputStatus').val()
        };

        console.log('Saving changes:', updatedData);
        alert('Changes saved successfully!');

        // Update the statistics
        $('#statStock').text(updatedData.stock);
        $('#statPrice').text('$' + parseFloat(updatedData.price).toFixed(2));

        // Update status badges
        const statusClass = updatedData.status === 'Active' ? 'status-active' : 'status-inactive';
        $('#statusBadge, #infoStatus').removeClass('status-active status-inactive').addClass(statusClass).text(updatedData.status);
    }

    function cancelChanges() {
        if (confirm('Are you sure you want to cancel? Any unsaved changes will be lost.')) {
            loadVariantData(variantData);
        }
    }
</script>