
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] Seller Dashboard</title>

    <link href="~/css/bootstrap.css" asp-append-version="true" rel="stylesheet" />
    <link href="~/css/site.css" asp-append-version="true" rel="stylesheet" />

    @* <link href="~/css/app.css" rel="stylesheet" /> *@
    <link href="~/lib/image-uploader/image-uploader.min.css" rel="stylesheet" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.6.0/uicons-thin-straight/css/uicons-thin-straight.css'>

    <style>
        .rotate-icon {
            transition: transform 0.3s ease;
        }

        .sidebar-link[aria-expanded="true"] .rotate-icon {
            transform: rotate(90deg);
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <nav id="sidebar" class="sidebar js-sidebar">
            <a class="sidebar-brand" href="~/Seller/Home/Index">
                <span class="align-middle">SELLER DASHBOARD</span>
            </a>
            <hr class="text-white m-0 p-0" />
            <div class="sidebar-content js-simplebar">

                <ul class="sidebar-nav">
                    @* 1. Dashboard *@
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <a class="sidebar-link" href="~/Seller/Home/Index">

                            <i style="height:17px" class="align-middle fa-solid fa-file-invoice"></i>
                            <span class="align-middle">Dashboard</span>
                        </a>
                    </li>

                    @* 2. Orders *@
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")">
                        <a class="sidebar-link" href="~/Seller/Home/Index">
                            <i class="align-middle bi bi-receipt"></i>
                            <span class="align-middle">Orders</span>
                        </a>
                    </li>

                    @* 3. Products *@<li class="sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index"
                                                                                                                               && ViewContext.RouteData.Values["Controller"]?.ToString() == "FeatureCategory" ? "active" : "")">

                        <a class="sidebar-link d-flex align-items-center justify-content-between"
                           data-bs-toggle="collapse"
                           href="#collapseProducts"
                           role="button"
                           aria-expanded="false"
                           aria-controls="collapseProducts">

                            <div>
                                <i class="align-middle bi bi-box-seam"></i>
                                <span class="align-middle">Products</span>
                            </div>

                            <!-- Rotating Arrow -->
                            <i class="bi bi-chevron-right rotate-icon"></i>
                        </a>

                        <div id="collapseProducts" class="collapse" data-bs-parent="#accordionExample">
                            <div style="display: grid; padding-left: 35px;">
                                <a class="sidebar-link" href="~/Seller/Product/Create">
                                    <span class="align-middle">Add New Product</span>
                                </a>

                                <a class="sidebar-link" href="~/Seller/Product/Index">
                                    <span class="align-middle">My Products</span>
                                </a>

                                <a class="sidebar-link" href="~/Admin/Category/Index">
                                    <span class="align-middle">Discounts / Offers</span>
                                </a>
                            </div>
                        </div>
                    </li>


                    @* 4. Inventory *@
                    <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManagement" ? "active" : "")">

                        <a class="sidebar-link d-flex justify-content-between align-content-center"
                           data-bs-toggle="collapse"
                           data-bs-target="#inventoryCollapse"
                           aria-expanded="false"
                           aria-controls="inventoryCollapse"
                           href="#adminLeftNavCollapse1"
                           role="button">

                            <div>
                                <i class="align-middle bi bi-archive"></i>
                                <span class="align-middle ">Inventory</span>
                            </div>
                            <i class="bi bi-chevron-right rotate-icon"></i>

                        </a>
                        <div id="inventoryCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                            <div style="display: grid;padding-left: 35px">
                                <a class="sidebar-link" href="#">
                                    <span class="align-middle">Stock Levels</span>
                                </a>
                                <a class="sidebar-link " href="#">
                                    <span class="align-middle">Low Stock</span>
                                </a>
                            </div>

                        </div>
                    </li>

                    @* 5. Store / Warehouse *@
                    <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManagement" ? "active" : "")">

                        <a class="sidebar-link d-flex justify-content-between align-content-center"
                           data-bs-toggle="collapse"
                           data-bs-target="#storesCollapse"
                           aria-expanded="false"
                           aria-controls="storesCollapse"
                           href="#adminLeftNavCollapse1"
                           role="button">

                            <div>
                                <i class="align-middle bi bi-shop"></i>
                                <span class="align-middle ">Store</span>
                            </div>
                            <!-- Rotating Arrow -->
                            <i class="bi bi-chevron-right rotate-icon"></i>
                        </a>
                        <div id="storesCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                            <div style="display: grid;padding-left: 35px">
                                <a class="sidebar-link" href="#">
                                    <span class="align-middle">My Stores</span>
                                </a>
                                <a class="sidebar-link " href="#">
                                    <span class="align-middle">Add Store</span>
                                </a>
                                <a class="sidebar-link " href="#">
                                    <span class="align-middle">Store Staff</span>
                                </a>
                            </div>

                        </div>
                    </li>


                    @* 6. Payments *@
                    <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManagement" ? "active" : "")">

                        <a class="sidebar-link d-flex justify-content-between align-content-center"
                           data-bs-toggle="collapse"
                           data-bs-target="#paymentsCollapse"
                           aria-expanded="false"
                           aria-controls="paymentsCollapse"
                           href="#adminLeftNavCollapse1"
                           role="button">

                            <div>
                                <i class="align-middle bi bi-credit-card"></i>
                                <span class="align-middle ">Payments</span>
                            </div>
                            <i class="bi bi-chevron-right rotate-icon"></i>

                        </a>
                        <div id="paymentsCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                            <div style="display: grid;padding-left: 35px">
                                <a class="sidebar-link" href="#">
                                    <span class="align-middle">Payment History</span>
                                </a>
                                <a class="sidebar-link " href="#">
                                    <span class="align-middle">Transactions</span>
                                </a>
                            </div>

                        </div>
                    </li>

                    @* 7. Feedback *@
                    <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManagement" ? "active" : "")">

                        <a class="sidebar-link d-flex justify-content-between align-content-center"
                           data-bs-toggle="collapse"
                           data-bs-target="#feedbackCollapse"
                           aria-expanded="false"
                           aria-controls="feedbackCollapse"
                           href="#adminLeftNavCollapse1"
                           role="button">
                            <div>
                                <i class="align-middle bi bi-chat-left-text"></i>
                                <span class="align-middle ">Feedback</span>
                            </div>
                            <i class="bi bi-chevron-right rotate-icon"></i>

                        </a>
                        <div id="feedbackCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                            <div style="display: grid;padding-left: 35px">
                                <a class="sidebar-link" href="#">
                                    <span class="align-middle">Product Reviews</span>
                                </a>
                                <a class="sidebar-link " href="#">
                                    <span class="align-middle">Customer Q&A</span>
                                </a>
                            </div>

                        </div>
                    </li>

                    @* 8. Notifications *@
                    <li class="sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Notification" ? "active" : "")">
                        <a class="sidebar-link" href="~/Seller/Home/Index">
                            <i class="align-middle bi bi-bell"></i>
                            <span class="align-middle">Notifications</span>
                        </a>
                    </li>

                    @* 9. Settings *@
                    <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManagement" ? "active" : "")">

                        <a class="sidebar-link d-flex justify-content-between align-content-center"
                            data-bs-toggle="collapse" 
                            data-bs-target="#settingsCollapse" 
                            aria-expanded="false" 
                            aria-controls="settingsCollapse"                             
                            href="#adminLeftNavCollapse1" 
                            role="button">
                            <div>
                            <i class="align-middle bi bi-gear"></i>
                            <span class="align-middle ">Settings</span>
                            </div>
                            <i class="bi bi-chevron-right rotate-icon"></i>

                        </a>
                        <div id="settingsCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                            <div style="display: grid;padding-left: 35px">
                                <a class="sidebar-link" href="#">
                                    <span class="align-middle">Store Profile</span>
                                </a>
                                <a class="sidebar-link " href="#">
                                    <span class="align-middle">Bank Details</span>
                                </a>
                                <a class="sidebar-link " href="#">
                                    <span class="align-middle">Change Password</span>
                                </a>
                            </div>
                        </div>
                    </li>
                </ul>

                <div class="sidebar-cta">
                    <div class="sidebar-cta-content">
                        <strong class="d-inline-block mb-2">Upgrade to Pro</strong>
                        <div class="mb-3 text-sm">
                            Are you looking for more components? Check out our premium version.
                        </div>
                        <div class="d-grid">
                            <a href="upgrade-to-pro.html" class="btn btn-primary">Upgrade to Pro</a>
                        </div>
                    </div>
                </div>
            </div>
        </nav>

