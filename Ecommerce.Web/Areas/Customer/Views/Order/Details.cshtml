@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/pages/customer/order.css" rel="stylesheet" />
<div class="container py-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-3">
                <h3 class="fw-bold m-0">Order #ORD-49230</h3>
                <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 rounded-pill">Delivered</span>
            </div>
            <div class="text-muted small mt-1">Placed on Nov 12, 2023 at 10:45 AM</div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary rounded-pill"><i class="bi bi-download me-2"></i>Invoice</button>
            <button class="btn btn-primary rounded-pill">Track Order</button>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="detail-card">
                <div class="card-header-custom">
                    <h5 class="fw-bold m-0">Items in Order (2)</h5>
                </div>
                <div class="p-4 pt-0">
                    <div class="product-item">
                        <img src="https://placehold.co/100x100/png?text=Sony" class="product-img me-3">
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1">Sony WH-1000XM5 Headphones</h6>
                            <div class="text-muted small">Color: Black | Qty: 1</div>
                        </div>
                        <div class="fw-bold">$348.00</div>
                    </div>
                    <div class="product-item">
                        <img src="https://placehold.co/100x100/png?text=Case" class="product-img me-3">
                        <div class="flex-grow-1">
                            <h6 class="fw-bold mb-1">Silicone Protective Case</h6>
                            <div class="text-muted small">Color: Midnight Blue | Qty: 1</div>
                        </div>
                        <div class="fw-bold">$15.00</div>
                    </div>
                </div>
            </div>

            <div class="detail-card">
                <div class="card-header-custom">
                    <h5 class="fw-bold m-0">Order Updates</h5>
                </div>
                <div class="p-4">
                    <div class="timeline">
                        <div class="timeline-item active">
                            <div class="timeline-dot"></div>
                            <div class="timeline-date">Nov 14, 2023 - 02:30 PM</div>
                            <div class="timeline-title text-success">Delivered</div>
                            <div class="timeline-desc">Package delivered to the reception. Signed by: Gate Security.</div>
                        </div>
                        <div class="timeline-item active">
                            <div class="timeline-dot"></div>
                            <div class="timeline-date">Nov 14, 2023 - 08:00 AM</div>
                            <div class="timeline-title">Out for Delivery</div>
                            <div class="timeline-desc">Courier agent has picked up the shipment.</div>
                        </div>
                        <div class="timeline-item active">
                            <div class="timeline-dot"></div>
                            <div class="timeline-date">Nov 13, 2023 - 06:45 PM</div>
                            <div class="timeline-title">Arrived at Sort Facility</div>
                            <div class="timeline-desc">Shipment has arrived at San Francisco Hub.</div>
                        </div>
                        <div class="timeline-item active">
                            <div class="timeline-dot"></div>
                            <div class="timeline-date">Nov 12, 2023 - 11:00 AM</div>
                            <div class="timeline-title">Order Placed</div>
                            <div class="timeline-desc">Your order has been confirmed.</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="detail-card p-4">
                <h5 class="fw-bold mb-4">Price Details</h5>
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Subtotal</span>
                    <span>$363.00</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Discount</span>
                    <span class="text-success">-$10.00</span>
                </div>
                <div class="d-flex justify-content-between mb-2 text-muted small">
                    <span>Shipping</span>
                    <span class="text-success">Free</span>
                </div>
                <div class="d-flex justify-content-between mb-3 text-muted small">
                    <span>Tax</span>
                    <span>$15.00</span>
                </div>
                <hr class="opacity-25">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark">Total Paid</span>
                    <span class="fw-bold fs-5 text-dark">$368.00</span>
                </div>
                <div class="alert alert-light border mt-3 mb-0 small text-center">
                    <i class="bi bi-credit-card-2-front me-1"></i> Paid via Visa ending in 4242
                </div>
            </div>

            <div class="detail-card p-4">
                <h5 class="fw-bold mb-3">Shipping Details</h5>
                <div class="d-flex gap-3">
                    <div class="bg-light rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                        <i class="bi bi-geo-alt text-muted"></i>
                    </div>
                    <div>
                        <div class="fw-bold">John Doe</div>
                        <div class="text-muted small mt-1">
                            123 Market Street, Apt 4B<br>
                            San Francisco, CA 94103<br>
                            United States
                        </div>
                        <div class="text-muted small mt-2">
                            <i class="bi bi-telephone me-1"></i> +1 234 567 8900
                        </div>
                    </div>
                </div>
            </div>

            <div class="detail-card p-4 text-center">
                <h6 class="fw-bold mb-2">Need Help with this order?</h6>
                <p class="text-muted small mb-3">Issues with the product or delivery?</p>
                <button class="btn btn-outline-dark btn-sm w-100">Contact Support</button>
            </div>

        </div>
    </div>
</div>