@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/pages/customer/profile.css" rel="stylesheet" />
<div class="container py-5">
    <div class="row g-4">

        <div class="col-lg-3">
            <div class="profile-sidebar mb-3">
                <div class="user-badge">
                    <div class="bg-white text-dark rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 fw-bold" style="width: 60px; height: 60px; font-size: 1.5rem;">JD</div>
                    <h5 class="m-0 fw-bold">John Doe</h5>
                    <small class="opacity-75">Member since 2023</small>
                </div>

                <div class="nav flex-column nav-pills p-2" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                    <button class="nav-link active" id="v-pills-profile-tab" data-bs-toggle="pill" data-bs-target="#v-pills-profile" type="button"><i class="bi bi-person"></i> Profile Info</button>
                    <button class="nav-link" id="v-pills-address-tab" data-bs-toggle="pill" data-bs-target="#v-pills-address" type="button"><i class="bi bi-geo-alt"></i> Addresses</button>
                    <button class="nav-link" id="v-pills-payment-tab" data-bs-toggle="pill" data-bs-target="#v-pills-payment" type="button"><i class="bi bi-credit-card"></i> Payments & Wallet</button>
                    <button class="nav-link " id="v-pills-orders-tab" data-bs-toggle="pill" data-bs-target="#v-pills-orders" type="button"><i class="bi bi-box-seam"></i> My Orders</button>
                    <button class="nav-link" id="v-pills-wishlist-tab" data-bs-toggle="pill" data-bs-target="#v-pills-wishlist" type="button"><i class="bi bi-heart"></i> Wishlist <span class="badge bg-danger ms-auto">4</span></button>
                    <button class="nav-link" id="v-pills-reviews-tab" data-bs-toggle="pill" data-bs-target="#v-pills-reviews" type="button"><i class="bi bi-star"></i> My Reviews</button>
                    <hr class="my-2 text-muted">
                    <button class="nav-link text-danger" data-bs-toggle="modal" data-bs-target="#logoutModal"><i class="bi bi-box-arrow-right"></i> Logout</button>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content" id="v-pills-tabContent">

                <div class="tab-pane fade show active" id="v-pills-profile" role="tabpanel">
        
                </div>
                <div class="tab-pane fade " id="v-pills-orders" role="tabpanel">
                    <h4 class="fw-bold mb-4">Order History</h4>

                    <div class="content-card mb-3 p-0 overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 border-bottom">
                            <div>
                                <span class="fw-bold text-dark">Order #49230</span>
                                <span class="text-muted small ms-2">| Nov 12, 2023</span>
                            </div>
                            <span class="badge bg-success">Delivered</span>
                        </div>
                        <div class="p-3">
                            <div class="d-flex gap-3 align-items-center">
                                <img src="https://placehold.co/80x80/png?text=Sony" class="rounded border">
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold m-0">Sony WH-1000XM5 Headphones</h6>
                                    <small class="text-muted">Color: Black</small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold">$348.00</div>
                                </div>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between align-items-center">
                                <a href="#" class="text-primary text-decoration-none fw-semibold">View Order Details</a>
                                <button class="btn btn-sm btn-outline-dark">Write Review</button>
                            </div>
                        </div>
                    </div>

                    <div class="content-card mb-3 p-0 overflow-hidden">
                        <div class="d-flex justify-content-between align-items-center bg-light p-3 border-bottom">
                            <div>
                                <span class="fw-bold text-dark">Order #49112</span>
                                <span class="text-muted small ms-2">| Nov 05, 2023</span>
                            </div>
                            <span class="badge bg-warning text-dark">In Transit</span>
                        </div>
                        <div class="p-3">
                            <div class="d-flex gap-3 align-items-center">
                                <img src="https://placehold.co/80x80/png?text=Case" class="rounded border">
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold m-0">Silicone Protective Case</h6>
                                    <small class="text-muted">Color: Blue</small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold">$15.00</div>
                                </div>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between align-items-center">
                                <a href="#" class="text-primary text-decoration-none fw-semibold">View Order Details</a>
                                <button class="btn btn-sm btn-primary">Track Package</button>
                            </div>
                        </div>
                    </div>
                </div>



                <div class="tab-pane fade" id="v-pills-address" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="fw-bold m-0">Saved Addresses</h4>
                        <button class="btn btn-sm btn-outline-primary"><i class="bi bi-plus-lg"></i> Add New</button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="content-card position-relative border border-primary">
                                <span class="badge bg-primary position-absolute top-0 end-0 m-3">Default</span>
                                <h6 class="fw-bold">John Doe <small class="text-muted fw-normal">(Home)</small></h6>
                                <p class="text-muted small mb-3">
                                    123 Market Street, Apt 4B<br>
                                    San Francisco, CA 94103<br>
                                    United States<br>
                                    Phone: +1 234 567 890
                                </p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-light border">Edit</button>
                                    <button class="btn btn-sm btn-light border text-danger">Delete</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="content-card position-relative border">
                                <h6 class="fw-bold">John Doe <small class="text-muted fw-normal">(Work)</small></h6>
                                <p class="text-muted small mb-3">
                                    500 Tech Plaza, Suite 200<br>
                                    San Jose, CA 95054<br>
                                    United States<br>
                                    Phone: +1 987 654 321
                                </p>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-light border">Edit</button>
                                    <button class="btn btn-sm btn-light border text-danger">Delete</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="v-pills-payment" role="tabpanel">

                    <div class="content-card mb-4 bg-light border-0">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <small class="text-uppercase fw-bold text-muted">Lumina Wallet Balance</small>
                                <h2 class="fw-bold text-success mb-0">$120.50</h2>
                            </div>
                            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                                <div class="input-group">
                                    <input type="text" class="form-control" placeholder="Enter Gift Card Code">
                                    <button class="btn btn-dark">Redeem</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h4 class="fw-bold mb-3">Saved Cards</h4>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6 col-lg-5">
                            <div class="credit-card-visual">
                                <div class="d-flex justify-content-between">
                                    <i class="bi bi-credit-card-2-front fs-2"></i>
                                    <i class="bi bi-wifi fs-4"></i>
                                </div>
                                <div>
                                    <div class="fs-5 mb-2" style="letter-spacing: 2px;">**** **** **** 4242</div>
                                    <div class="d-flex justify-content-between small opacity-75">
                                        <span>JOHN DOE</span>
                                        <span>12/25</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h4 class="fw-bold mb-3">Saved UPI</h4>
                    <div class="content-card p-3 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <img src="https://placehold.co/40x40/png?text=GPay" class="rounded">
                            <div>
                                <div class="fw-bold">john.doe@okhdfcbank</div>
                                <small class="text-muted">Google Pay</small>
                            </div>
                        </div>
                        <button class="btn btn-sm text-danger"><i class="bi bi-trash"></i></button>
                    </div>
                </div>

                <div class="tab-pane fade" id="v-pills-wishlist" role="tabpanel">
                    <h4 class="fw-bold mb-4">My Wishlist (4)</h4>

                    <div class="content-card p-0 overflow-hidden">
                        <div class="d-flex align-items-center p-3 border-bottom">
                            <img src="https://placehold.co/80x80/png?text=Watch" class="wishlist-img rounded border">
                            <div class="ms-3 flex-grow-1">
                                <h6 class="fw-bold m-0">Apple Watch Series 8</h6>
                                <div class="text-primary fw-bold">$399.00</div>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <button class="btn btn-sm btn-primary rounded-pill">Add to Cart</button>
                                <button class="btn btn-sm btn-light text-muted"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                        <div class="d-flex align-items-center p-3">
                            <img src="https://placehold.co/80x80/png?text=Camera" class="wishlist-img rounded border">
                            <div class="ms-3 flex-grow-1">
                                <h6 class="fw-bold m-0">Canon EOS R50</h6>
                                <div class="text-primary fw-bold">$650.00</div>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <button class="btn btn-sm btn-primary rounded-pill">Add to Cart</button>
                                <button class="btn btn-sm btn-light text-muted"><i class="bi bi-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="v-pills-reviews" role="tabpanel">
                    <h4 class="fw-bold mb-4">My Ratings & Reviews</h4>
                    <div class="content-card">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <h6 class="fw-bold">Nike Air Jordan Retro</h6>
                                <small class="text-muted">Oct 24, 2023</small>
                            </div>
                            <div class="text-warning mb-2">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i>
                            </div>
                            <p class="text-muted small">
                                "Absolutely love these shoes! The fit is perfect and the delivery was super fast. Highly recommended."
                            </p>
                        </div>
                        <hr>
                        <div class="mb-0">
                            <div class="d-flex justify-content-between">
                                <h6 class="fw-bold">Gaming Mouse Logitech</h6>
                                <small class="text-muted">Sep 10, 2023</small>
                            </div>
                            <div class="text-warning mb-2">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i><i class="bi bi-star"></i>
                            </div>
                            <p class="text-muted small">
                                "Good grip and response time. The software is a bit buggy though."
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="logoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Sign Out</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="bi bi-box-arrow-right display-1 text-muted mb-3"></i>
                <p class="mb-0 text-muted">Are you sure you want to log out of your account?</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger px-4">Log Out</button>
            </div>
        </div>
    </div>
</div>
<script src="~/js/CustomerJS/profile.js"></script>
