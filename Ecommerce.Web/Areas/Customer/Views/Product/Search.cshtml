@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/pages/customer/search.css" rel="stylesheet" />

<div class="container my-4">
    <div class="row g-4">

        <div class="col-lg-3">
            <div class="mb-3 d-flex align-items-center justify-content-between">
                <h5 class="fw-bold m-0">Filters</h5>
                <select class="form-select form-select-sm w-auto border-0 bg-transparent fw-semibold text-primary" aria-label="Sort By">
                    <option selected>Sort by: Relevance</option>
                    <option value="1">Price: Low to High</option>
                    <option value="2">Price: High to Low</option>
                    <option value="3">Newest First</option>
                </select>
            </div>

            <div class="card filter-card p-4 bg-white">
                <div class="mb-4">
                    <div class="filter-group-title">Price Range</div>
                    <div class="d-flex align-items-center gap-2">
                        <input type="number" class="form-control price-input" placeholder="Min">
                        <span class="text-muted">-</span>
                        <input type="number" class="form-control price-input" placeholder="Max">
                        <button class="btn btn-sm btn-primary rounded-pill"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
                <hr class="text-muted opacity-25">

                <div class="mb-4">
                    <div class="filter-group-title">Brand</div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="brand1">
                        <label class="form-check-label" for="brand1">Sony (45)</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="brand2">
                        <label class="form-check-label" for="brand2">Bose (32)</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="brand3">
                        <label class="form-check-label" for="brand3">JBL (28)</label>
                    </div>
                    <a href="#" class="small text-primary fw-bold text-decoration-none">Show More</a>
                </div>
                <hr class="text-muted opacity-25">

                <div class="mb-4">
                    <div class="filter-group-title">Customer Ratings</div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="rating4">
                        <label class="form-check-label d-flex align-items-center gap-1" for="rating4">
                            <span class="text-warning"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i></span>
                            <span class="small">& Up</span>
                        </label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="rating3">
                        <label class="form-check-label d-flex align-items-center gap-1" for="rating3">
                            <span class="text-warning"><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i><i class="bi bi-star"></i></span>
                            <span class="small">& Up</span>
                        </label>
                    </div>
                </div>

            </div>
        </div>

        <div class="col-lg-9">
            <h5 class="fw-bold mb-3">Showing results for "Headphones" <span class="text-muted fw-normal small">(128 items)</span></h5>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                <div class="col">
                    <div class="product-card p-3 shadow-sm">
                        <span class="badge-deal">Best Seller</span>
                        <div class="product-img-wrapper">
                            <img src="https://placehold.co/200x200/png?text=Sony+XM5" class="product-img" alt="Product">
                        </div>
                        <div class="mt-3">
                            <h6 class="fw-bold text-dark text-truncate">Sony WH-1000XM5 Noise Canceling</h6>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="price-new">$348.00</span>
                                <span class="price-old">$399.00</span>
                            </div>
                            <div class="d-flex gap-1 text-warning small mb-3">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                                <span class="text-muted ms-1">(2.1k)</span>
                            </div>
                            <button class="btn btn-primary w-100 rounded-pill">Add to Cart</button>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="product-card p-3 shadow-sm">
                        <div class="product-img-wrapper">
                            <img src="https://placehold.co/200x200/png?text=Bose+QC45" class="product-img" alt="Product">
                        </div>
                        <div class="mt-3">
                            <h6 class="fw-bold text-dark text-truncate">Bose QuietComfort 45 Bluetooth</h6>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="price-new">$279.00</span>
                            </div>
                            <div class="d-flex gap-1 text-warning small mb-3">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i>
                                <span class="text-muted ms-1">(950)</span>
                            </div>
                            <button class="btn btn-primary w-100 rounded-pill">Add to Cart</button>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="product-card p-3 shadow-sm">
                        <span class="badge-deal bg-warning text-dark">-20%</span>
                        <div class="product-img-wrapper">
                            <img src="https://placehold.co/200x200/png?text=JBL+Live" class="product-img" alt="Product">
                        </div>
                        <div class="mt-3">
                            <h6 class="fw-bold text-dark text-truncate">JBL Live 660NC Wireless Over-Ear</h6>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="price-new">$159.95</span>
                                <span class="price-old">$199.95</span>
                            </div>
                            <div class="d-flex gap-1 text-warning small mb-3">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i><i class="bi bi-star"></i>
                                <span class="text-muted ms-1">(420)</span>
                            </div>
                            <button class="btn btn-primary w-100 rounded-pill">Add to Cart</button>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="product-card p-3 shadow-sm">
                        <div class="product-img-wrapper">
                            <img src="https://placehold.co/200x200/png?text=Beats+Studio" class="product-img" alt="Product">
                        </div>
                        <div class="mt-3">
                            <h6 class="fw-bold text-dark text-truncate">Beats Studio3 Wireless Noise Cancelling</h6>
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="price-new">$199.00</span>
                                <span class="price-old">$349.95</span>
                            </div>
                            <div class="d-flex gap-1 text-warning small mb-3">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star"></i>
                                <span class="text-muted ms-1">(3.5k)</span>
                            </div>
                            <button class="btn btn-primary w-100 rounded-pill">Add to Cart</button>
                        </div>
                    </div>
                </div>
            </div>

            <nav aria-label="Page navigation" class="mt-5 d-flex justify-content-center">
                <ul class="pagination">
                    <li class="page-item disabled"><a class="page-link border-0 rounded-circle mx-1" href="#"><i class="bi bi-chevron-left"></i></a></li>
                    <li class="page-item active"><a class="page-link border-0 rounded-circle mx-1 bg-primary" href="#">1</a></li>
                    <li class="page-item"><a class="page-link border-0 rounded-circle mx-1 text-dark" href="#">2</a></li>
                    <li class="page-item"><a class="page-link border-0 rounded-circle mx-1 text-dark" href="#">3</a></li>
                    <li class="page-item"><a class="page-link border-0 rounded-circle mx-1 text-dark" href="#"><i class="bi bi-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
