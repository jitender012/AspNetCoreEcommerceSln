<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ecommerce.Web</title>
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/admin-layout.css" rel="stylesheet" />


    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    @* bootstrap5 datatables css *@
    <link href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" rel="stylesheet" />

    <link href="~/css/bootstrap.css" rel="stylesheet" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce.Web.styles.css" asp-append-version="true" />

</head>
<body>
    <div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>
    <!-- Side Navigation -->
    <nav id="sidebar" class="sidebar">
        <div class="sidebar-header">
            <span class="align-middle">ADMIN DASHBOARD</span>
        </div>
        <hr class="text-white m-0 p-0" />

        <ul class="sidebar-menu">
            @* 1. Home *@
            <li class="sidebar-item ">
                <a class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" href="~/Admin/Home/Index">
                    @* <i class="align-middle " data-feather="home"></i>  *@
                    <i class="bi bi-house-door"></i>
                    <span class="align-middle">Dashboard</span>
                </a>
            </li>

            @* 2. Product Management *@
            <li class="sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "FeatureCategory" ? "active" : "")">

                <a class="sidebar-link d-flex align-items-center justify-content-between"
                   href="#collapseProducts"
                   aria-controls="collapseProducts"
                    data-bs-toggle="collapse"
                    role="button"
                    aria-expanded="false">

                    <div>
                        <i class="align-middle bi bi-box-seam"></i>
                        <span class="align-middle">Product Management</span>
                    </div>
                    <i class="bi bi-chevron-right rotate-icon"></i>
                </a>

                <div id="collapseProducts" class="collapse" data-bs-parent="#accordionExample">
                    <div style="display: grid;padding-left:35px">

                        <a class="sidebar-link" href="~/brands">
                            <span>Brands</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/Category/Index">
                            <span class="align-middle">Product Categories</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/FeatureCategory/Index">
                            <span class="align-middle">Feature Categoies</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/ProductFeature/Index">
                            <span class="align-middle">Product Features</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/ProductFeature/Index">
                            <span class="align-middle">Products</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/ProductFeature/Index">
                            <span class="align-middle">Product Gallery</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/ProductFeature/Index">
                            <span class="align-middle">Product Approvals</span>
                        </a>
                    </div>

                </div>
            </li>

            @* 2. User Management *@
            <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "UserManagement" ? "active" : "")">

                <a data-bs-toggle="collapse" data-bs-target="#userManagementCollapse" aria-expanded="false" aria-controls="userManagementCollapse" class="sidebar-link d-flex align-items-center justify-content-between " href="#adminLeftNavCollapse1" role="button">

                    <div>
                        <i class="align-middle bi-people"></i>
                        <span class="align-middle">User Management</span>
                    </div>

                    <!-- Rotating Arrow -->
                    <i class="bi bi-chevron-right rotate-icon"></i>
                </a>
                <div id="userManagementCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                    <div style="display: grid;padding-left:35px">
                        <a class="sidebar-link" href="~/Admin/Brand/Index">
                            <span class="align-middle">Customers</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/Category/Index">
                            <span class="align-middle">Sellers</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/FeatureCategory/Index">
                            <span class="align-middle">Adimns / Roles</span>
                        </a>
                    </div>

                </div>
            </li>

            @* Order Management *@
            <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "OrderManagement" ? "active" : "")">

                <a class="sidebar-link d-flex align-items-center justify-content-between" data-bs-toggle="collapse" data-bs-target="#orderManagementCollapse" aria-expanded="false" aria-controls="orderManagementCollapse" href="#adminLeftNavCollapse1" role="button">

                    <div>
                        <i class="align-middle bi-cart-check"></i>
                        <span class="align-middle">Order Management</span>
                    </div>

                    <!-- Rotating Arrow -->
                    <i class="bi bi-chevron-right rotate-icon"></i>
                </a>
                <div id="orderManagementCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                    <div style="display: grid;padding-left:35px">
                        <a class="sidebar-link" href="~/Admin/Brand/Index">
                            <span class="align-middle">Orders List</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/Category/Index">
                            <span class="align-middle">Order Status</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/FeatureCategory/Index">
                            <span class="align-middle">Transactions</span>
                        </a>
                    </div>

                </div>
            </li>

            <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "ContentManagement" ? "active" : "")">

                <a class="sidebar-link d-flex align-items-center justify-content-between "
                   data-bs-toggle="collapse"
                   data-bs-target="#contentManagementCollapse"
                   aria-expanded="false"
                   aria-controls="contentManagementCollapse"
                   href="#adminLeftNavCollapse1" role="button">

                    <div>
                        <i class="align-middle bi-layout-text-window"></i>
                        <span class="align-middle">Content Management</span>
                    </div>

                    <!-- Rotating Arrow -->
                    <i class="bi bi-chevron-right rotate-icon"></i>
                   
                </a>
                <div id="contentManagementCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                    <div style="display: grid;padding-left:35px">
                        <a class="sidebar-link" href="~/Admin/Brand/Index">
                            <span class="align-middle">Bannerst</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/Category/Index">
                            <span class="align-middle">Announcements</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/FeatureCategory/Index">
                            <span class="align-middle">Site Pages</span>
                        </a>
                    </div>

                </div>
            </li>

            <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "SystemSettings" ? "active" : "")">

                <a class="sidebar-link d-flex align-items-center justify-content-between" data-bs-toggle="collapse" data-bs-target="#systemSettingsCollapse" aria-expanded="false" aria-controls="systemSettingsCollapse" href="#adminLeftNavCollapse1" role="button">

                    <div>
                        <i class="align-middle bi-gear"></i>
                        <span class="align-middle">System Settings</span>
                    </div>

                    <!-- Rotating Arrow -->
                    <i class="bi bi-chevron-right rotate-icon"></i>
                                        
                </a>
                <div id="systemSettingsCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                    <div style="display: grid;padding-left:35px">
                        <a class="sidebar-link" href="~/Admin/Brand/Index">
                            <span class="align-middle">General Settings</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/Category/Index">
                            <span class="align-middle">Tax</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/FeatureCategory/Index">
                            <span class="align-middle">Shipping Rules</span>
                        </a>
                    </div>

                </div>
            </li>

            <li class=" sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Reports" ? "active" : "")">

                <a class="sidebar-link d-flex align-items-center justify-content-between" data-bs-toggle="collapse" data-bs-target="#reportsCollapse" aria-expanded="false" aria-controls="reportsCollapse"  href="#adminLeftNavCollapse1" role="button">

                    <div>
                        <i class="align-middle bi-graph-up-arrow"></i>
                        <span class="align-middle">Reports</span>
                    </div>

                    <!-- Rotating Arrow -->
                    <i class="bi bi-chevron-right rotate-icon"></i>                    
                </a>
                <div id="reportsCollapse" class="accordion-collapse collapse " data-bs-parent="#accordionExample">
                    <div style="display: grid;padding-left:35px">
                        <a class="sidebar-link" href="~/Admin/Brand/Index">
                            <span class="align-middle">Sales Report</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/Category/Index">
                            <span class="align-middle">Product Performance</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/FeatureCategory/Index">
                            <span class="align-middle">Seller Performance</span>
                        </a>
                        <a class="sidebar-link " href="~/Admin/FeatureCategory/Index">
                            <span class="align-middle">Customer Insights</span>
                        </a>
                    </div>

                </div>
            </li>
            <li class="sidebar-item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "archive" ? "active" : "")">
                <a class="sidebar-link" href="~/Admin/Home/Index">
                    <i class="align-middle bi-archive" ></i> <span class="align-middle">Archive</span>
                </a>
            </li>
        </ul>
    </nav>



    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- Top Navigation -->
    <nav class="top-nav" id="topNav">
        <button class="hamburger" id="hamburger">
            <i class="fas fa-bars"></i>
        </button>
        <div class="top-nav-actions">
            <button class="notification-icon">
                <i class="fas fa-bell"></i>
                <span class="notification-badge">3</span>
            </button>
            <button class="message-icon">
                <i class="fas fa-comment"></i>
            </button>

            <div class="dropdown">
                <a href="#" role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-chevron-down fs-4 icon-color"></i>
                </a>

                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profile</a></li>
                    <li><a class="dropdown-item" href="#"><i class="bi bi-gear me-2"></i>Settings</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="/account/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="main-content" id="mainContent">
        <main class="content">
            @RenderBody()
        </main>

        <footer class="footer">
            <div class="container-fluid">
                <div class="row text-muted">
                    <div class="col-6 text-start">
                        <p class="mb-0">
                            <a class="text-muted" href="https://adminkit.io/" target="_blank"><strong>AdminKit</strong></a> - <a class="text-muted" href="https://adminkit.io/" target="_blank"><strong>Bootstrap Admin Template</strong></a>								&copy;
                        </p>
                    </div>
                    <div class="col-6 text-end">
                        <ul class="list-inline">
                            <li class="list-inline-item">
                                <a class="text-muted" href="https://adminkit.io/" target="_blank">Support</a>
                            </li>
                            <li class="list-inline-item">
                                <a class="text-muted" href="https://adminkit.io/" target="_blank">Help Center</a>
                            </li>
                            <li class="list-inline-item">
                                <a class="text-muted" href="https://adminkit.io/" target="_blank">Privacy</a>
                            </li>
                            <li class="list-inline-item">
                                <a class="text-muted" href="https://adminkit.io/" target="_blank">Terms</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    </div>




    @* common modal for confirming *@
    <div class="modal fade" id="commonConfirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="confirmModalBody">Are you sure?</div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="commonConfirmBtn" class="btn btn-danger">Yes</button>
                </div>
            </div>
        </div>
    </div>
    @* common modal for confirming *@

    <script src="~/js/bootstrap.bundle.min.js"></script>
    @* Default Scripts *@    
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const sidebar = document.getElementById('sidebar');
        const topNav = document.getElementById('topNav');
        const mainContent = document.getElementById('mainContent');
        const hamburger = document.getElementById('hamburger');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        hamburger.addEventListener('click', function() {
            if (window.innerWidth > 768) {
                // Desktop behavior
                sidebar.classList.toggle('collapsed');
                topNav.classList.toggle('expanded');
                mainContent.classList.toggle('expanded');
            } else {
                // Mobile behavior
                sidebar.classList.toggle('show');
                sidebarOverlay.classList.toggle('show');
            }
        });

        // Close sidebar when clicking overlay on mobile
        sidebarOverlay.addEventListener('click', function() {
            sidebar.classList.remove('show');
            sidebarOverlay.classList.remove('show');
        });

        // Handle window resize
        window.addEventListener('resize', function() {
            if (window.innerWidth > 768) {
                sidebar.classList.remove('show');
                sidebarOverlay.classList.remove('show');
            }
        });
    </script>
</body>
</html>
